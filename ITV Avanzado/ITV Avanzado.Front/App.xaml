<Application x:Class="ITV_Avanzado.Front.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Buttons -->
            <Style x:Key="BaseButton" TargetType="Button">
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="15,8" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="#C8AA6E" />
                <Setter Property="Foreground" Value="#0B0F1A" />
                <Setter Property="BorderBrush" Value="#C8AA6E" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="#1E2A3A" />
                <Setter Property="Foreground" Value="#C8AA6E" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="#8B1A1A" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="BorderBrush" Value="#F44336" />
            </Style>

            <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
                <Setter Property="Background" Value="#1A4A1A" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="BorderBrush" Value="#4CAF50" />
            </Style>

            <!-- TextBox -->
            <Style x:Key="AppTextBox" TargetType="TextBox">
                <Setter Property="Background" Value="#121A2A" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- ComboBox -->
            <Style x:Key="AppComboBox" TargetType="ComboBox">
                <Setter Property="Background" Value="#121A2A" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- DatePicker -->
            <Style x:Key="AppDatePicker" TargetType="DatePicker">
                <Setter Property="Background" Value="#121A2A" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- Labels -->
            <Style x:Key="HeaderLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#C8AA6E" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#A38A4A" />
            </Style>

            <Style x:Key="ValueLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="FontSize" Value="15" />
            </Style>

            <!-- DataGrid -->
            <Style x:Key="AppDataGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Background" Value="#0F1923" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="RowBackground" Value="#0F1923" />
                <Setter Property="AlternatingRowBackground" Value="#16202B" />
                <Setter Property="RowHeight" Value="36" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="HeadersVisibility" Value="Column" />
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#111822" />
                <Setter Property="Foreground" Value="#C8AA6E" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="10" />
            </Style>

            <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#0F1923" />
                <Setter Property="Foreground" Value="#F0E6D2" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#17344F" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#2A3A4A" />
                        <Setter Property="Foreground" Value="#F0C75E" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Card -->
            <Style x:Key="AppCard" TargetType="Border">
                <Setter Property="Background" Value="#121A2A" />
                <Setter Property="BorderBrush" Value="#2A2F3A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="15" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>