<Page x:Class="ITV_Avanzado.Front.View.Backup.BackupView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Background="#0B0F1A">
    
    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                Background="#121A2A"
                BorderBrush="#C8AA6E"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal">

                <iconPacks:PackIconMaterial
                    Kind="DatabaseLock"
                    Width="30"
                    Height="30"
                    Foreground="#C8AA6E"
                    Margin="0,0,12,0"/>

                <StackPanel>
                    <TextBlock Text="Copias de Seguridad"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#C8AA6E"/>

                    <TextBlock Text="Gestión de Backups del sistema ITV"
                               FontSize="12"
                               Foreground="#A38A4A"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ================= ACTION BAR ================= -->
        <Border Grid.Row="1"
                Background="#121A2A"
                BorderBrush="#2A2F3A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,20">

            <UniformGrid Columns="2">

                <Button Content="💾 Crear Backup"
                        Command="{Binding RealizarBackupCommand}"
                        Margin="0,0,10,0"
                        Padding="10"
                        Background="Transparent"
                        Foreground="#C8AA6E"
                        BorderBrush="#C8AA6E"
                        BorderThickness="1"/>

                <Button Content="🔄 Refrescar"
                        Command="{Binding RefreshCommand}"
                        Padding="10"
                        Background="Transparent"
                        Foreground="#C8AA6E"
                        BorderBrush="#C8AA6E"
                        BorderThickness="1"/>

            </UniformGrid>
        </Border>

        <!-- ================= MAIN CONTENT ================= -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>

            <!-- LISTA -->
            <Border Grid.Column="0"
                    Background="#121A2A"
                    BorderBrush="#C8AA6E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,15,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Historial de Backups"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#C8AA6E"
                               Margin="0,0,0,15"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Backups}"
                             SelectedItem="{Binding SelectedBackup}"
                             Background="#0F172A"
                             BorderThickness="0"
                             Foreground="#E5D5B8">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        CornerRadius="8"
                                        BorderBrush="#2A2F3A"
                                        BorderThickness="1"
                                        Background="#111827">

                                    <StackPanel Orientation="Horizontal">

                                        <iconPacks:PackIconMaterial
                                            Kind="FolderZip"
                                            Width="18"
                                            Height="18"
                                            Foreground="#C8AA6E"
                                            Margin="0,0,8,0"/>

                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   Foreground="#E5D5B8"/>
                                    </StackPanel>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

            <!-- PANEL DERECHO -->
            <Border Grid.Column="1"
                    Background="#121A2A"
                    BorderBrush="#C8AA6E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- título -->
                    <TextBlock Text="Panel de Control"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#C8AA6E"
                               Margin="0,0,0,20"/>

                    <!-- info -->
                    <StackPanel Grid.Row="1">

                        <TextBlock Text="Backup Seleccionado"
                                   Foreground="#A38A4A"
                                   FontWeight="SemiBold"/>

                        <Border Margin="0,8,0,25"
                                Padding="10"
                                Background="#0F172A"
                                CornerRadius="8"
                                BorderBrush="#2A2F3A"
                                BorderThickness="1">

                            <TextBlock Text="{Binding SelectedBackup}"
                                       Foreground="#E5D5B8"
                                       TextWrapping="Wrap"/>
                        </Border>

                    </StackPanel>

                    <!-- botones -->
                    <StackPanel Grid.Row="2">

                        <Button Content="♻ Restaurar"
                                Command="{Binding RestaurarBackupCommand}"
                                Margin="0,0,0,10"
                                Padding="10"
                                Background="Transparent"
                                Foreground="#C8AA6E"
                                BorderBrush="#C8AA6E"
                                BorderThickness="1"/>

                        <Button Content="🗑 Eliminar"
                                Command="{Binding EliminarBackupCommand}"
                                Padding="10"
                                Background="#2A1111"
                                Foreground="#FF6B6B"
                                BorderBrush="#8B1E1E"
                                BorderThickness="1"/>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>

        <!-- ================= STATUS ================= -->
        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Background="#121A2A"
                BorderBrush="#C8AA6E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">

            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#A38A4A"
                       HorizontalAlignment="Center"/>
        </Border>

    </Grid>
</Page>
