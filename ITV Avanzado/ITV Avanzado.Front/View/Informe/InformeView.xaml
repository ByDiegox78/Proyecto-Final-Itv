<Page x:Class="ITV_Avanzado.Front.View.Informe.InformeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
      Title="ITV VIVES - Informes"
      Background="#0B0F1A"
      Foreground="#C8AA6E">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER ================= -->
        <Border Grid.Row="0"
                Background="#121A2A"
                BorderBrush="#C8AA6E"
                BorderThickness="1"
                CornerRadius="10"
                Padding="15"
                Margin="0,0,0,20">

            <StackPanel Orientation="Horizontal">

                <iconPacks:PackIconMaterial Kind="FileDocument"
                                            Width="32"
                                            Height="32"
                                            Foreground="#C8AA6E"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"/>

                <StackPanel>
                    <TextBlock Text="INFORMES ITV VIVES"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#C8AA6E"/>

                    <TextBlock Text="Generación de informes del sistema"
                               FontSize="12"
                               Foreground="#A38A4A"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ================= OPTIONS ================= -->
        <Border Grid.Row="1"
                Background="#121A2A"
                BorderBrush="#2A2F3A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,20">

            <CheckBox Content="Mostrar eliminados"
                      IsChecked="{Binding MostrarEliminados}"
                      Foreground="#C8AA6E"/>
        </Border>

        <!-- ================= BOTONES ================= -->
        <Grid Grid.Row="2"
              VerticalAlignment="Center"
              HorizontalAlignment="Center">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#121A2A"
                    BorderBrush="#C8AA6E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="0,0,10,0"
                    Padding="30"
                    Width="250">

                <StackPanel HorizontalAlignment="Center">

                    <iconPacks:PackIconMaterial Kind="FileDocument"
                                                Width="40"
                                                Height="40"
                                                Foreground="#C8AA6E"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,15"/>

                    <TextBlock Text="PDF"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#C8AA6E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <Button Content="Generar Informe PDF"
                            Command="{Binding GenerarInformeGeneralPdfCommand}"
                            Background="Transparent"
                            Foreground="#C8AA6E"
                            BorderBrush="#C8AA6E"
                            BorderThickness="1"
                            Padding="12"
                            Width="180"/>

                </StackPanel>

            </Border>

            <Border Grid.Column="1"
                    Background="#121A2A"
                    BorderBrush="#C8AA6E"
                    BorderThickness="1"
                    CornerRadius="10"
                    Margin="10,0,0,0"
                    Padding="30"
                    Width="250">

                <StackPanel HorizontalAlignment="Center">

                    <iconPacks:PackIconMaterial Kind="LanguageHtml5"
                                                Width="40"
                                                Height="40"
                                                Foreground="#C8AA6E"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,15"/>

                    <TextBlock Text="HTML"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="#C8AA6E"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,15"/>

                    <Button Content="Generar Informe HTML"
                            Command="{Binding GenerarInformeGeneralHtmlCommand}"
                            Background="Transparent"
                            Foreground="#C8AA6E"
                            BorderBrush="#C8AA6E"
                            BorderThickness="1"
                            Padding="12"
                            Width="180"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- ================= STATUS ================= -->
        <Border Grid.Row="3"
                Margin="0,20,0,0"
                Background="#121A2A"
                BorderBrush="#C8AA6E"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="#A38A4A"
                       FontSize="12"
                       HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Page>